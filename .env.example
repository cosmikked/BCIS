# BCIS environment. Copy to .env and fill in. Never commit .env.
# No secrets belong in this file.

APP_NAME=BCIS
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Timezone is fixed to Asia/Manila in config/app.php (INV-22).
APP_LOCALE=en_PH
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_PH

APP_MAINTENANCE_DRIVER=file

# Logging: JSON daily files with redaction and a request id (NFR-06).
LOG_CHANNEL=json
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
LOG_DAILY_DAYS=30

# PostgreSQL only. The running app uses the limited runtime role (bcis_app).
# Run migrations with the owner role by overriding these two for that command:
#   DB_USERNAME=bcis_owner DB_PASSWORD=... php artisan migrate
# Roles and databases are created by scripts/db-setup.sql (see README).
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=bcis
DB_USERNAME=bcis_app
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# Argon2id cost (hashing driver is fixed to argon2id in config/hashing.php).
ARGON_MEMORY=65536
ARGON_TIME=4
ARGON_THREADS=1

# Seed credentials (php artisan migrate:fresh --seed). Choose your own values.
# The Owner must change the initial password at first login. Demo users are
# skipped in production.
OWNER_USERNAME=owner
OWNER_FULL_NAME="System Owner"
OWNER_INITIAL_PASSWORD=
SEED_DEMO_PASSWORD=

MAIL_MAILER=log

VITE_APP_NAME="${APP_NAME}"
